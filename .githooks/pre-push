#!/bin/sh
#
# 푸시 "직전"에 백엔드 타입 검사를 돌려서, Railway 빌드가 깨질 코드가
# 원격에 올라가는 것을 막는다.
#
# 왜 필요한가:
#   Railway는 푸시가 끝난 뒤에야 빌드를 시작한다. 즉 "푸시 전에 원격에서
#   미리 빌드해보는" 방법은 원리상 존재하지 않는다. 대신 Railway가 실행하는
#   것과 같은 tsc 검사를 로컬에서 푸시 전에 돌려 같은 효과를 낸다.
#
# 활성화 (클론한 사람마다 1회):
#   yarn hooks:install       (= git config core.hooksPath .githooks)
#
# 급할 때 건너뛰기:
#   git push --no-verify
#
# 검사 범위: tsc만 (약 5~10초). Docker 빌드 전체는 2~4분이라 푸시마다 돌리기엔
# 무겁다. 그건 푸시 후 GitHub Actions(backend-docker-build.yml)가 맡는다.

# 백엔드와 무관한 변경(문서, 프론트엔드 등)만 있으면 건너뛴다.
range_start=$(git merge-base HEAD "@{upstream}" 2>/dev/null)
if [ -n "$range_start" ]; then
  changed=$(git diff --name-only "$range_start" HEAD)
else
  # upstream이 없는 새 브랜치 — 커밋된 파일 전체를 대상으로 본다.
  changed=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || echo "apps/backend/")
fi

if ! echo "$changed" | grep -qE '^(apps/backend/|package\.json|yarn\.lock|Dockerfile|\.dockerignore)'; then
  echo "[pre-push] 백엔드 변경 없음 — 타입 검사 건너뜀"
  exit 0
fi

echo "[pre-push] 백엔드 타입 검사 중… (건너뛰려면 git push --no-verify)"

if ! yarn --cwd "$(git rev-parse --show-toplevel)" typecheck; then
  echo ""
  echo "  ✖ 타입 에러가 있습니다. 이대로 푸시하면 Railway 배포가 실패합니다."
  echo "    고친 뒤 다시 푸시하거나, 의도한 것이라면 git push --no-verify 로 강제 푸시하세요."
  echo ""
  exit 1
fi

echo "[pre-push] 통과"
exit 0
